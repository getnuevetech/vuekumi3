# Copy to /opt/vuekumi/.env on the Lightsail instance
#   cp deploy/lightsail/env.production.example .env
#   nano .env

# --- required ---
DOMAIN=your-domain.com
POSTGRES_PASSWORD=change-this-strong-password
JWT_SECRET=generate-with-openssl-rand-base64-48
COOKIE_SECRET=generate-with-openssl-rand-base64-48
WEB_URL=https://your-domain.com

# --- optional (email, payments, AI — future phases) ---
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Do not set VITE_API_URL in production — nginx proxies /api on same origin
