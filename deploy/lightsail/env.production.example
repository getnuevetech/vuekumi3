# Copy to /opt/vuekumi/.env on the Lightsail instance
#   cp deploy/lightsail/env.production.example .env
#   nano .env
#
# Only infrastructure secrets belong here.
# Payment, email, AI, and storage API keys are entered in Admin → Settings.

DOMAIN=your-domain.com
POSTGRES_PASSWORD=change-this-strong-password
JWT_SECRET=generate-with-openssl-rand-base64-48
COOKIE_SECRET=generate-with-openssl-rand-base64-48
WEB_URL=http://YOUR_STATIC_IP
# Match how people actually open the site. https:// with HTTP-only nginx
# used to mark session cookies Secure, so login appeared to work and every
# admin request then returned Unauthorized.

# Optional: dedicated key for encrypting Admin Settings values (defaults to JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=

# Demo seed — OFF by default. Seed is destructive (deleteMany wipe + recreate).
# First boot only: SEED_DEMO=1 for one deploy, then remove or set back to 0.
# Routine redeploys must leave this unset/0 or live users and grants are wiped.
# SEED_DEMO=0
