generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  admin
  photographer
  photo_influencer
  contributor
  user
  agency
  model
}

enum UserStatus {
  active
  suspended
  pending
}

enum AdminRole {
  super_admin
  moderator
  finance
  support
}

enum AgencyRole {
  owner
  admin
  manager
  member
  viewer
}

enum AgencyStatus {
  pending
  active
  suspended
}

enum PhotoStatus {
  draft
  pending
  active
  rejected
  delisted
}

enum PermissionState {
  private
  portfolio
  editorial
  restricted
  commercial
  exclusive
  agency_protected
}

enum LicenseType {
  free
  premium
}

enum GrantLicenseType {
  royalty_free
  commercial
  extended
  editorial
  rights_managed
  exclusive
}

enum ModelReleaseStatus {
  not_required
  pending
  verified
  rejected
}

enum CopyrightStatus {
  claimed
  documented
  verified
  disputed
  restricted
}

enum ModelConsentStatus {
  not_required
  required
  invitation_sent
  pending
  approved
  rejected
  revoked
  disputed
}

enum ReleaseVerificationLevel {
  photographer_provided
  vuekumi_verified
}

enum CopyrightMethod {
  attestation
  document
  vuekumi_direct
}

enum LikenessQuality {
  claimed
  documented
  verified
}

enum CreationClaim {
  self_created
  photographer_took
  assigned
  licensed
  unknown
}

enum RightsLedgerActorKind {
  user
  guest
  staff
  system
}

enum AppearanceDecisionKind {
  approved
  rejected
  not_me
  unauthorized
  revoked
}

enum SubjectAgeClass {
  unknown
  adult
  minor
}

enum RightsScreeningKind {
  no_recognizable_person
  one_recognizable_person
  multiple_recognizable_people
  crowd_background_persons
  uncertain_human_detection
}

enum ModelAppearanceStatus {
  identified
  invited
  claimed
  approved
  rejected
  revoked
}

enum ModelUsagePreference {
  none
  editorial
  commercial
}

enum LikenessCheckStatus {
  similar
  not_similar
  inconclusive
  unavailable
}

enum PlatformAgreementStatus {
  accepted
  revoked
}

enum CreatorKind {
  photographer
  photo_influencer
}

enum BookingKind {
  photographer
  model
}

enum BookingStatus {
  pending
  quoted
  accepted
  declined
  withdrawn
}

enum BookingAvailability {
  open
  limited
  unavailable
}

enum RepresentationStatus {
  requested
  represented
  declined
  ended
  withdrawn
}

enum InquiryStatus {
  new
  answered
  closed
}

enum CampaignStatus {
  open
  closed
}

enum PitchStatus {
  pending
  accepted
  declined
  withdrawn
}

enum PartnerKeyStatus {
  active
  revoked
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  name            String
  accountType     AccountType
  status          UserStatus   @default(active)
  country         String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  rightsStrikeCount Int       @default(0)
  repeatInfringerAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contributorProfile ContributorProfile?
  modelProfile       ModelProfile?
  userProfile        UserProfile?
  adminProfile       AdminProfile?
  agencyMembers      AgencyMember[]
  ownedAgencies      Agency[]             @relation("AgencyOwner")
  photos             Photo[]              @relation("ContributorPhotos")
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  platformAgreements PlatformAgreement[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  moderationReviews  ModerationItem[]     @relation("ModerationReviewer")
  licenseGrants       LicenseGrant[]
  modelReleaseReviews ModelRelease[]  @relation("ModelReleaseReviewer")
  licenseQuotes       LicenseQuote[]  @relation("QuoteRequester")
  payments            Payment[]
  earningsLedgers     EarningsLedger[] @relation("ContributorEarnings")
  aiSuggestions       AiSuggestion[]   @relation("AiSuggestionRequester")
  agencyInvitesSent   AgencyInvite[]   @relation("AgencyInviteSender")
  oauthAccounts       OAuthAccount[]
  payoutMethods       PayoutMethod[]
  payouts             Payout[]         @relation("ContributorPayouts")
  payoutsProcessed    Payout[]         @relation("PayoutProcessor")
  photoFavorites      PhotoFavorite[]
  following           PhotographerFollow[] @relation("UserFollowing")
  followers           PhotographerFollow[] @relation("UserFollowers")
  collections         Collection[]        @relation("CollectionOwner")
  collectionAdds      CollectionPhoto[]   @relation("CollectionAdder")
  subscriptions       Subscription[]
  rightsReportsFiled    RightsReport[] @relation("RightsReporter")
  rightsReportsReviewed RightsReport[] @relation("RightsReviewer")
  commercialLocks       Photo[]        @relation("CommercialLockActor")
  modelAppearances      PhotoAppearance[] @relation("ModelAppearances")
  appearancesInvited    PhotoAppearance[] @relation("AppearanceInviter")
  likenessChecks        LikenessCheck[]   @relation("LikenessCheckModel")
  rightsProcessVerified RightsRecord[] @relation("RightsProcessVerifier")
  photoShoots           PhotoShoot[]      @relation("PhotographerShoots")
  uploadedReleases      ModelRelease[]    @relation("ReleaseUploader")
  bookingsReceived      BookingRequest[] @relation("BookingTarget")
  bookingsSent          BookingRequest[] @relation("BookingRequester")
  representation        Representation?
  representationInquiries RepresentationInquiry[]
  campaigns             Campaign[]
  campaignPitches       CampaignPitch[]
  partnerKeysCreated    PartnerApiKey[]
  photosUploaded        Photo[]              @relation("PhotoUploader")
  rightsLedgerEvents    RightsLedgerEvent[]  @relation("LedgerActor")
  copyrightAuthorizations CopyrightAuthorization[] @relation("CopyrightHolder")
  copyrightInvitesSent    CopyrightAuthorization[] @relation("CopyrightInviter")
  dmcaNoticesReviewed     DmcaNotice[]             @relation("DmcaReviewer")
  rightsStrikes           RightsStrike[]           @relation("StrikeSubject")
  rightsStrikesRecorded   RightsStrike[]           @relation("StrikeActor")

  @@index([accountType])
  @@index([status])
}

model PartnerApiKey {
  id           String           @id @default(cuid())
  name         String
  note         String?
  keyHash      String           @unique
  keyPrefix    String
  status       PartnerKeyStatus @default(active)
  requestCount Int              @default(0)
  lastUsedAt   DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
}

model Campaign {
  id           String         @id @default(cuid())
  ownerId      String
  title        String
  brief        String
  deliverables String?
  usage        String?
  location     String?
  startDate    DateTime?
  endDate      DateTime?
  budgetUsd    Float?
  status       CampaignStatus @default(open)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pitches CampaignPitch[]

  @@index([status, createdAt])
  @@index([ownerId])
}

model CampaignPitch {
  id            String      @id @default(cuid())
  campaignId    String
  contributorId String
  note          String
  rateUsd       Float?
  status        PitchStatus @default(pending)
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contributor User     @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contributorId])
  @@index([contributorId])
}

model Representation {
  id            String               @id @default(cuid())
  contributorId String               @unique
  status        RepresentationStatus @default(requested)
  note          String?
  staffNote     String?
  requestedAt   DateTime             @default(now())
  decidedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  contributor User @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@index([status])
}

model RepresentationInquiry {
  id          String        @id @default(cuid())
  photoId     String
  requesterId String?
  name        String
  email       String
  company     String?
  message     String
  status      InquiryStatus @default(new)
  staffNote   String?
  ipAddress   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  photo     Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  requester User? @relation(fields: [requesterId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([photoId])
}

model BookingRequest {
  id          String        @id @default(cuid())
  kind        BookingKind
  targetId    String
  requesterId String
  title       String
  brief       String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  budgetUsd   Float?
  quoteUsd    Float?
  quoteNote   String?
  status      BookingStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  target    User @relation("BookingTarget", fields: [targetId], references: [id], onDelete: Cascade)
  requester User @relation("BookingRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([targetId, status])
  @@index([requesterId])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model ContributorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  handle        String   @unique
  creatorKind   CreatorKind @default(photographer)
  availability  BookingAvailability @default(open)
  dayRateUsd    Float?
  location      String?
  bio           String?
  photosCount   Int      @default(0)
  downloads     Int      @default(0)
  earnings      Float    @default(0)
  approvalRate  Int      @default(0)
  profileViews  Int      @default(0)
  payoutMethod  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModelProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  handle       String   @unique
  availability BookingAvailability @default(open)
  dayRateUsd   Float?
  location     String?
  bio          String?
  profileViews Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  subscriptionPlan    String    @default("free")
  plusUntil           DateTime?
  downloadQuotaUsed   Int       @default(0)
  downloadQuotaReset  DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  plan        String    @default("plus")
  status      String    @default("pending")
  amountUsd   Float
  currency    String
  amountLocal Float
  provider    String
  providerRef String?   @unique
  checkoutUrl String?
  periodStart DateTime?
  periodEnd   DateTime?
  cancelledAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AdminProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  adminRole               AdminRole @default(support)
  capabilities            String[]  @default([])
  capabilitiesCustomized  Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agency {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  ownerUserId     String
  status          AgencyStatus @default(pending)
  plan            String       @default("enterprise")
  seatLimit       Int          @default(20)
  billingEmail    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner         User           @relation("AgencyOwner", fields: [ownerUserId], references: [id])
  members       AgencyMember[]
  invites       AgencyInvite[]
  licenseGrants LicenseGrant[]
  licenseQuotes LicenseQuote[]
  collections   Collection[]
}

model AgencyInvite {
  id          String     @id @default(cuid())
  agencyId    String
  email       String
  agencyRole  AgencyRole @default(member)
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("AgencyInviteSender", fields: [invitedById], references: [id])

  @@index([agencyId])
  @@index([email])
}

model AgencyMember {
  id         String     @id @default(cuid())
  agencyId   String
  userId     String
  agencyRole AgencyRole @default(member)
  status     String     @default("active")
  joinedAt   DateTime   @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

model Photo {
  id                    String      @id
  contributorId         String
  title                 String
  description           String?
  category              String
  country               String
  licenseType           LicenseType @default(free)
  price                 Float       @default(0)
  status                PhotoStatus @default(active)
  src                   String
  storageKey            String?
  downloads             Int         @default(0)
  views                 Int         @default(0)
  likes                 Int         @default(0)
  hasRecognizablePeople Boolean     @default(false)
  exclusiveAvailable    Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  publishedAt           DateTime?

  exclusiveSold      Boolean           @default(false)
  width              Int?
  height             Int?
  processingStatus   String            @default("ready")
  commercialLocked     Boolean   @default(false)
  commercialLockedAt   DateTime?
  commercialLockedById String?
  /// Phase 57 — machine-readable quarantine reason (see COMMERCIAL_LOCK_REASON_CODES).
  commercialLockReason String?
  permissionState    PermissionState @default(commercial)
  restrictionNotes   String?
  shootId                  String?
  screeningKind            RightsScreeningKind?
  screeningPeopleCount     Int      @default(0)
  possibleMinor            Boolean  @default(false)
  crowdBackground          Boolean  @default(false)
  selfPortraitLikely       Boolean  @default(false)
  potentiallySensitive     Boolean  @default(false)
  uncertainHumanDetection  Boolean  @default(false)
  screeningNotes           String?
  screeningAt              DateTime?
  screeningProvider        String?

  uploadedById             String?
  creationClaim            CreationClaim @default(self_created)
  copyrightAiTraining      Boolean   @default(false)
  aiTrainingEligible       Boolean   @default(false)

  contributor      User              @relation("ContributorPhotos", fields: [contributorId], references: [id])
  uploadedBy       User?             @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  shoot            PhotoShoot?       @relation(fields: [shootId], references: [id], onDelete: SetNull)
  tags             PhotoTag[]
  rightsRecord     RightsRecord?
  moderationItems  ModerationItem[]
  modelReleases    ModelRelease[]
  licenseGrants    LicenseGrant[]
  licenseQuotes    LicenseQuote[]
  assets           PhotoAsset[]
  payments         Payment[]
  earningsLedgers  EarningsLedger[]
  aiSuggestions    AiSuggestion[]
  favorites        PhotoFavorite[]
  collectionPhotos CollectionPhoto[]
  rightsReports    RightsReport[]
  representationInquiries RepresentationInquiry[]
  commercialLockedBy User? @relation("CommercialLockActor", fields: [commercialLockedById], references: [id], onDelete: SetNull)
  appearances      PhotoAppearance[]
  copyrightAuthorizations CopyrightAuthorization[]
  ledgerEvents     RightsLedgerEvent[]
  dmcaNotices      DmcaNotice[]
  rightsStrikes    RightsStrike[]
  featuredPins     HomeFeaturedPin[]

  @@index([status])
  @@index([category])
  @@index([country])
  @@index([contributorId])
  @@index([uploadedById])
  @@index([commercialLocked])
  @@index([permissionState])
  @@index([shootId])
}

model HomeFeaturedPin {
  id        String   @id @default(cuid())
  slot      String
  position  Int
  photoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([slot, position])
  @@index([photoId])
  @@index([slot])
}

model PhotoShoot {
  id             String   @id @default(cuid())
  photographerId String
  title          String
  shotOn         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photographer User    @relation("PhotographerShoots", fields: [photographerId], references: [id], onDelete: Cascade)
  photos       Photo[]

  @@index([photographerId])
}

model AiSuggestion {
  id                      String   @id @default(cuid())
  photoId                 String
  requestedById           String
  provider                String
  status                  String   @default("ready")
  title                   String?
  description             String?
  category                String?
  country                 String?
  tags                    String[]
  hasRecognizablePeople   Boolean?
  notes                   String?
  createdAt               DateTime @default(now())
  appliedAt               DateTime?

  photo       Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("AiSuggestionRequester", fields: [requestedById], references: [id])

  @@index([photoId])
  @@index([requestedById])
}

enum AssetKind {
  original
  preview
  watermarked
  thumb
}

model PhotoAsset {
  id         String    @id @default(cuid())
  photoId    String
  kind       AssetKind
  storageKey String
  bytes      Int       @default(0)
  width      Int?
  height     Int?
  mimeType   String    @default("image/jpeg")
  createdAt  DateTime  @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, kind])
  @@index([storageKey])
}

model PhotoTag {
  id      String @id @default(cuid())
  photoId String
  tag     String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, tag])
  @@index([tag])
}

model PhotoFavorite {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
  @@index([photoId])
  @@index([userId])
}

model PhotographerFollow {
  id             String   @id @default(cuid())
  followerId     String
  photographerId String
  createdAt      DateTime @default(now())

  follower     User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  photographer User @relation("UserFollowers", fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([followerId, photographerId])
  @@index([photographerId])
  @@index([followerId])
}

model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  agencyId    String?
  name        String
  description String?
  visibility  String   @default("private")
  shareToken  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User              @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agency Agency?           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  photos CollectionPhoto[]

  @@index([ownerId])
  @@index([agencyId])
}

model CollectionPhoto {
  id           String   @id @default(cuid())
  collectionId String
  photoId      String
  addedById    String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photo      Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  addedBy    User       @relation("CollectionAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([collectionId, photoId])
  @@index([photoId])
  @@index([addedById])
}

model RightsRecord {
  id                   String             @id @default(cuid())
  photoId              String             @unique
  copyrightVerified    Boolean            @default(false)
  copyrightHolder      String?
  copyrightStatus      CopyrightStatus    @default(claimed)
  copyrightAttestedAt  DateTime?
  copyrightMethod      CopyrightMethod    @default(attestation)
  modelReleaseRequired Boolean            @default(false)
  modelReleaseStatus   ModelReleaseStatus @default(not_required)
  modelReleaseFileKey  String?
  modelConsentStatus   ModelConsentStatus @default(not_required)
  commercialEligible   Boolean            @default(false)
  platformRightsOk     Boolean            @default(false)
  processVerifiedAt    DateTime?
  processVerifiedById  String?
  consentVersion       String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  photo             Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  processVerifiedBy User? @relation("RightsProcessVerifier", fields: [processVerifiedById], references: [id], onDelete: SetNull)
}

model RightsLedgerEvent {
  id                  String                 @id @default(cuid())
  photoId             String
  actorId             String?
  actorKind           RightsLedgerActorKind  @default(system)
  action              String
  agreementVersion    String?
  scopesJson          Json?
  channel             String?
  relatedIdsJson      Json?
  previousCopyright   CopyrightStatus?
  nextCopyright       CopyrightStatus?
  previousLikeness    ModelConsentStatus?
  nextLikeness        ModelConsentStatus?
  previousQuality     String?
  nextQuality         String?
  commercialEligible  Boolean                @default(false)
  ip                  String?
  userAgent           String?
  createdAt           DateTime               @default(now())

  photo Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  actor User?  @relation("LedgerActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([photoId, createdAt])
  @@index([actorId])
}

model ModelRelease {
  id                   String                    @id @default(cuid())
  photoId              String
  photographerId       String?
  appearanceId         String?
  fileName             String
  notes                String?
  status               ModelReleaseStatus        @default(pending)
  verificationLevel    ReleaseVerificationLevel  @default(photographer_provided)
  attestedGenuine      Boolean                   @default(false)
  attestedAt           DateTime?
  modelIdentity        String?
  confirmationSentAt   DateTime?
  modelConfirmedAt     DateTime?
  verifiedById         String?
  verifiedAt           DateTime?
  createdAt            DateTime                  @default(now())

  photo          Photo            @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photographer   User?            @relation("ReleaseUploader", fields: [photographerId], references: [id], onDelete: SetNull)
  appearance     PhotoAppearance? @relation(fields: [appearanceId], references: [id], onDelete: SetNull)
  verifiedBy     User?            @relation("ModelReleaseReviewer", fields: [verifiedById], references: [id])

  @@index([photoId])
  @@index([status])
  @@index([photographerId])
  @@index([appearanceId])
}

model CopyrightAuthorization {
  id                     String                         @id @default(cuid())
  photoId                String
  displayName            String
  inviteEmail            String?
  inviteMobile           String?
  photographerUserId     String?
  invitedById            String
  status                 ModelAppearanceStatus          @default(identified)
  decisionKind           AppearanceDecisionKind?
  usage                  ModelUsagePreference           @default(none)
  portfolioDisplay       Boolean                        @default(false)
  commercialSublicensing Boolean                        @default(false)
  aiTraining             Boolean                        @default(false)
  quality                CopyrightStatus                @default(claimed)
  documentFileName       String?
  documentKey            String?
  inviteTokenHash        String?                        @unique
  inviteExpiresAt        DateTime?
  invitedAt              DateTime?
  claimedAt              DateTime?
  decidedAt              DateTime?
  consentVersion         String?
  notes                  String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  photo              Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photographerUser   User? @relation("CopyrightHolder", fields: [photographerUserId], references: [id], onDelete: SetNull)
  invitedBy          User  @relation("CopyrightInviter", fields: [invitedById], references: [id])

  @@index([photoId])
  @@index([photographerUserId])
  @@index([inviteEmail])
  @@index([status])
}

model PhotoAppearance {
  id                    String                   @id @default(cuid())
  photoId               String
  displayName           String
  inviteEmail           String?
  inviteMobile          String?
  modelUserId           String?
  invitedById           String
  status                ModelAppearanceStatus    @default(identified)
  consentStatus         ModelConsentStatus       @default(required)
  decisionKind          AppearanceDecisionKind?
  usage                 ModelUsagePreference     @default(none)
  aiTraining            Boolean                  @default(false)
  confirmedLikeness     Boolean                  @default(false)
  inviteTokenHash       String?                  @unique
  inviteExpiresAt       DateTime?
  invitedAt             DateTime?
  claimedAt             DateTime?
  decidedAt             DateTime?
  consentVersion        String?
  selfShot              Boolean                  @default(false)
  notes                 String?
  ageClass              SubjectAgeClass          @default(unknown)
  isMinor               Boolean                  @default(false)
  guardianName          String?
  guardianEmail         String?
  guardianMobile        String?
  guardianAuthorizedAt  DateTime?
  verificationLevel     ReleaseVerificationLevel?
  consentQuality        LikenessQuality           @default(claimed)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  photo          Photo           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  modelUser      User?           @relation("ModelAppearances", fields: [modelUserId], references: [id], onDelete: SetNull)
  invitedBy      User            @relation("AppearanceInviter", fields: [invitedById], references: [id])
  likenessChecks LikenessCheck[]
  releases       ModelRelease[]

  @@index([photoId])
  @@index([modelUserId])
  @@index([inviteEmail])
  @@index([status])
  @@index([consentStatus])
}

model LikenessCheck {
  id                 String              @id @default(cuid())
  appearanceId       String
  modelUserId        String
  photoId            String
  status             LikenessCheckStatus
  consentedAt        DateTime
  comparedAt         DateTime
  provider           String
  referenceDeletedAt DateTime
  notes              String?
  createdAt          DateTime            @default(now())

  appearance PhotoAppearance @relation(fields: [appearanceId], references: [id], onDelete: Cascade)
  modelUser  User            @relation("LikenessCheckModel", fields: [modelUserId], references: [id], onDelete: Cascade)

  @@index([appearanceId, createdAt])
  @@index([modelUserId])
  @@index([photoId])
}

model LicenseProduct {
  id                   String           @id
  type                 GrantLicenseType @unique
  name                 String
  description          String
  defaultUsd           Float            @default(0)
  points               String[]
  commercialAllowed    Boolean          @default(true)
  requiresModelRelease Boolean          @default(false)
  agencyPreferred      Boolean          @default(false)
  quoteOnly            Boolean          @default(false)
  exclusiveOptIn       Boolean          @default(false)
  sortOrder            Int              @default(0)
  active               Boolean          @default(true)
  grants               LicenseGrant[]
  quotes               LicenseQuote[]
  payments             Payment[]
}

enum QuoteStatus {
  pending
  quoted
  accepted
  declined
}

model LicenseQuote {
  id          String         @id @default(cuid())
  photoId     String
  requesterId String
  agencyId    String?
  productId   String
  territory   String
  duration    String
  channels    String
  notes       String?
  quoteUsd    Float?
  status      QuoteStatus    @default(pending)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  photo     Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  requester User           @relation("QuoteRequester", fields: [requesterId], references: [id])
  agency    Agency?        @relation(fields: [agencyId], references: [id])
  product   LicenseProduct @relation(fields: [productId], references: [id])
  grants    LicenseGrant[]

  @@index([photoId])
  @@index([requesterId])
  @@index([agencyId])
  @@index([status])
}

model LicenseGrant {
  id              String           @id @default(cuid())
  buyerId         String
  photoId         String
  productId       String
  agencyId        String?
  quoteId         String?          @unique
  licenseType     GrantLicenseType
  amountUsd       Float
  currency        String           @default("USD")
  amountLocal     Float
  scopeJson         Json
  ledgerHeadId      String?
  ledgerSnapshot    Json?
  certificateCode   String           @unique
  agreementKind     String?
  agreementVersion  String?
  createdAt         DateTime         @default(now())

  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  photo   Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  product LicenseProduct @relation(fields: [productId], references: [id])
  agency  Agency?        @relation(fields: [agencyId], references: [id])
  quote   LicenseQuote?  @relation(fields: [quoteId], references: [id])
  payment Payment?

  @@index([buyerId])
  @@index([photoId])
  @@index([agencyId])
}

model Payment {
  id          String   @id @default(cuid())
  buyerId     String
  photoId     String
  productId   String
  quoteId     String?
  grantId     String?  @unique
  provider    String
  status      String   @default("pending")
  amountUsd   Float
  currency    String
  amountLocal Float
  providerRef String?  @unique
  checkoutUrl String?
  metadata    Json?
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  photo   Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  product LicenseProduct @relation(fields: [productId], references: [id])
  grant   LicenseGrant?  @relation(fields: [grantId], references: [id])
  earnings EarningsLedger[]

  @@index([buyerId])
  @@index([photoId])
  @@index([status])
}

model PayoutMethod {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  label       String
  accountName String
  accountRef  String
  bankName    String?
  country     String?
  currency    String   @default("USD")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([userId])
}

model Payout {
  id             String    @id @default(cuid())
  contributorId  String
  payoutMethodId String
  amountUsd      Float
  status         String    @default("requested")
  notes          String?
  provider       String    @default("manual")
  providerRef    String?
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?
  processedById  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contributor User         @relation("ContributorPayouts", fields: [contributorId], references: [id], onDelete: Cascade)
  method      PayoutMethod @relation(fields: [payoutMethodId], references: [id])
  processor   User?        @relation("PayoutProcessor", fields: [processedById], references: [id])
  ledger      EarningsLedger[]

  @@index([contributorId])
  @@index([status])
}

model EarningsLedger {
  id            String   @id @default(cuid())
  contributorId String
  photoId       String
  paymentId     String?
  grantId       String?
  payoutId      String?
  source        String
  amountUsd     Float
  status        String   @default("available")
  holdReason    String?
  heldAt        DateTime?
  createdAt     DateTime @default(now())

  contributor User     @relation("ContributorEarnings", fields: [contributorId], references: [id], onDelete: Cascade)
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  payment     Payment? @relation(fields: [paymentId], references: [id])
  payout      Payout?  @relation(fields: [payoutId], references: [id])

  @@index([contributorId])
  @@index([photoId])
  @@index([payoutId])
}

model AgreementVersion {
  version       String   @id
  kind          String   @default("photographer")
  title         String
  body          String
  current       Boolean  @default(false)
  counselStatus String   @default("placeholder")
  publishedAt   DateTime @default(now())

  @@index([kind])
}

model PlatformAgreement {
  id              String                  @id @default(cuid())
  userId          String
  version         String
  status          PlatformAgreementStatus @default(accepted)
  acceptedAt      DateTime                @default(now())
  ipAddress       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModerationItem {
  id           String    @id @default(cuid())
  photoId      String
  flag         String
  status       String    @default("pending")
  submittedBy  String
  reviewerId   String?
  decidedAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  photo    Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ModerationReviewer", fields: [reviewerId], references: [id])

  @@index([status])
}

enum RightsReportReason {
  copyright
  likeness
  unauthorized_use
  fraudulent_release
  safety_urgent
  compensation_dispute
  other
}

enum RightsReportStatus {
  open
  reviewing
  dismissed
  resolved
}

model RightsReport {
  id             String             @id @default(cuid())
  photoId        String
  reason         RightsReportReason
  details        String
  status         RightsReportStatus @default(open)
  urgent         Boolean            @default(false)
  queue          String             @default("general")
  /// Phase 51 / T2 SOP stage (docs/07 §8).
  sopStage       String             @default("intake")
  evidencePreservedAt DateTime?
  evidenceNotes  String?
  notifiedAt     DateTime?
  escalateTo     String?
  escalatedAt    DateTime?
  reporterUserId String?
  reporterEmail  String?
  reporterName   String?
  ipAddress      String?
  userAgent      String?
  reviewerId     String?
  reviewedAt     DateTime?
  staffNotes     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  photo    Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  reporter User? @relation("RightsReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reviewer User? @relation("RightsReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([photoId])
  @@index([status])
  @@index([createdAt])
  @@index([urgent])
  @@index([queue])
  @@index([sopStage])
}

enum DmcaNoticeStatus {
  received
  processing
  waiting_counter
  counter_received
  waiting_restore
  restored
  rejected
  closed
}

enum RightsStrikeReason {
  fake_release
  fake_photographer
  false_creation_claim
  upheld_copyright_fraud
  upheld_likeness_fraud
}

model DmcaNotice {
  id                  String           @id @default(cuid())
  photoId             String?
  photoUrl            String?
  claimantName        String
  claimantEmail       String
  claimantAddress     String
  claimantPhone       String?
  workDescription     String
  originalLocation    String
  infringingLocation  String
  goodFaith           Boolean          @default(true)
  perjury             Boolean          @default(true)
  signature           String
  status              DmcaNoticeStatus @default(received)
  restoreEligibleAt   DateTime?
  reviewerId          String?
  reviewedAt          DateTime?
  staffNotes          String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  photo    Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  reviewer User?              @relation("DmcaReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  counter  DmcaCounterNotice?

  @@index([photoId])
  @@index([status])
  @@index([createdAt])
}

model DmcaCounterNotice {
  id                     String   @id @default(cuid())
  noticeId               String   @unique
  senderName             String
  senderEmail            String
  senderAddress          String
  senderPhone            String?
  statement              String
  consentToJurisdiction  Boolean  @default(true)
  perjury                Boolean  @default(true)
  signature              String
  ipAddress              String?
  createdAt              DateTime @default(now())

  notice DmcaNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

model RightsStrike {
  id        String             @id @default(cuid())
  userId    String
  reason    RightsStrikeReason
  photoId   String?
  noticeId  String?
  notes     String
  actorId   String?
  createdAt DateTime           @default(now())

  user  User   @relation("StrikeSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User?  @relation("StrikeActor", fields: [actorId], references: [id], onDelete: SetNull)
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([photoId])
  @@index([createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  initiatedBy String    @default("self")
  adminId     String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
}

model PlatformSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(true)
  label     String?
  group     String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Country {
  code                  String   @id
  name                  String
  currency              String
  currencyName          String
  region                String
  contributorEligible   Boolean  @default(false)
  enabled               Boolean  @default(true)
  sortOrder             Int      @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  legalOverlay   LegalOverlay?
  policyVersions CountryPolicyVersion[]

  @@index([region])
  @@index([contributorEligible])
}

model LegalOverlay {
  countryCode              String   @id
  overlayKind              String
  contributorAllowed       Boolean
  dataTransferNotice       String
  commissionedPhotoPrompt  String
  extraNotice              String?
  biometricForbidden       Boolean  @default(true)
  counselStatus            String   @default("placeholder")
  lawLabel                 String?
  updatedAt                DateTime @updatedAt

  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@index([overlayKind])
}

/// Phase 49 / P0 — country policy version. Status changes only via CountryTransition.
model CountryPolicyVersion {
  id            String   @id @default(cuid())
  countryCode   String
  version       Int
  status        String   @default("HOLD")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  publishedAt   DateTime?
  preparedById  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  country      Country               @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  gates        CountryGate[]
  featureScopes CountryFeatureScope[]
  transitions  CountryTransition[]

  @@unique([countryCode, version])
  @@index([countryCode, status])
  @@index([status])
}

model CountryGate {
  id              String   @id @default(cuid())
  policyVersionId String
  code            String
  title           String
  status          String   @default("NOT_STARTED")
  rationale       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  policyVersion CountryPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  evidence      GateEvidence[]
  approvals     GateApproval[]

  @@unique([policyVersionId, code])
  @@index([status])
}

model GateEvidence {
  id        String   @id @default(cuid())
  gateId    String
  label     String
  url       String?
  notes     String?
  addedById String?
  createdAt DateTime @default(now())

  gate CountryGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([gateId])
}

model GateApproval {
  id         String   @id @default(cuid())
  gateId     String
  approverId String
  decision   String
  notes      String?
  createdAt  DateTime @default(now())

  gate CountryGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([gateId])
  @@index([approverId])
}

model CountryFeatureScope {
  id              String   @id @default(cuid())
  policyVersionId String
  action          String
  state           String   @default("HOLD")
  notes           String?
  updatedAt       DateTime @updatedAt

  policyVersion CountryPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, action])
}

model CountryTransition {
  id              String   @id @default(cuid())
  policyVersionId String
  kind            String
  fromStatus      String
  toStatus        String
  actorId         String
  authorizeId     String?
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  policyVersion CountryPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@index([policyVersionId])
  @@index([kind])
  @@index([createdAt])
}

model ExchangeRate {
  currency     String    @id
  rateToUsd    Float
  source       String    @default("auto")
  overrideRate Float?
  fetchedAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

model PaymentGateway {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  kind        String
  countries   String[]
  currencies  String[]
  configEnc   String?
  publicKey   String?
  notes       String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiProvider {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  purpose    String
  apiBaseUrl String?
  apiKeyEnc  String?
  notes      String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
