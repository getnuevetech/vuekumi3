generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  admin
  contributor
  user
  agency
}

enum UserStatus {
  active
  suspended
  pending
}

enum AdminRole {
  super_admin
  moderator
  finance
  support
}

enum AgencyRole {
  owner
  admin
  manager
  member
  viewer
}

enum AgencyStatus {
  pending
  active
  suspended
}

enum PhotoStatus {
  draft
  pending
  active
  rejected
  delisted
}

enum LicenseType {
  free
  premium
}

enum GrantLicenseType {
  royalty_free
  commercial
  extended
  editorial
  rights_managed
  exclusive
}

enum ModelReleaseStatus {
  not_required
  pending
  verified
  rejected
}

enum PlatformAgreementStatus {
  accepted
  revoked
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  name            String
  accountType     AccountType
  status          UserStatus   @default(active)
  country         String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contributorProfile ContributorProfile?
  userProfile        UserProfile?
  adminProfile       AdminProfile?
  agencyMembers      AgencyMember[]
  ownedAgencies      Agency[]             @relation("AgencyOwner")
  photos             Photo[]              @relation("ContributorPhotos")
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  platformAgreements PlatformAgreement[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  moderationReviews  ModerationItem[]     @relation("ModerationReviewer")
  licenseGrants       LicenseGrant[]
  modelReleaseReviews ModelRelease[]  @relation("ModelReleaseReviewer")
  licenseQuotes       LicenseQuote[]  @relation("QuoteRequester")
  payments            Payment[]
  earningsLedgers     EarningsLedger[] @relation("ContributorEarnings")
  aiSuggestions       AiSuggestion[]   @relation("AiSuggestionRequester")
  agencyInvitesSent   AgencyInvite[]   @relation("AgencyInviteSender")
  oauthAccounts       OAuthAccount[]
  payoutMethods       PayoutMethod[]
  payouts             Payout[]         @relation("ContributorPayouts")
  payoutsProcessed    Payout[]         @relation("PayoutProcessor")
  photoFavorites      PhotoFavorite[]
  collections         Collection[]        @relation("CollectionOwner")
  collectionAdds      CollectionPhoto[]   @relation("CollectionAdder")

  @@index([accountType])
  @@index([status])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model ContributorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  handle        String   @unique
  location      String?
  bio           String?
  photosCount   Int      @default(0)
  downloads     Int      @default(0)
  earnings      Float    @default(0)
  approvalRate  Int      @default(0)
  payoutMethod  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  subscriptionPlan    String   @default("free")
  downloadQuotaUsed   Int      @default(0)
  downloadQuotaReset  DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  adminRole AdminRole @default(support)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agency {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  ownerUserId     String
  status          AgencyStatus @default(pending)
  plan            String       @default("enterprise")
  seatLimit       Int          @default(20)
  billingEmail    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner         User           @relation("AgencyOwner", fields: [ownerUserId], references: [id])
  members       AgencyMember[]
  invites       AgencyInvite[]
  licenseGrants LicenseGrant[]
  licenseQuotes LicenseQuote[]
  collections   Collection[]
}

model AgencyInvite {
  id          String     @id @default(cuid())
  agencyId    String
  email       String
  agencyRole  AgencyRole @default(member)
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("AgencyInviteSender", fields: [invitedById], references: [id])

  @@index([agencyId])
  @@index([email])
}

model AgencyMember {
  id         String     @id @default(cuid())
  agencyId   String
  userId     String
  agencyRole AgencyRole @default(member)
  status     String     @default("active")
  joinedAt   DateTime   @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

model Photo {
  id                    String      @id
  contributorId         String
  title                 String
  description           String?
  category              String
  country               String
  licenseType           LicenseType @default(free)
  price                 Float       @default(0)
  status                PhotoStatus @default(active)
  src                   String
  storageKey            String?
  downloads             Int         @default(0)
  views                 Int         @default(0)
  likes                 Int         @default(0)
  hasRecognizablePeople Boolean     @default(false)
  exclusiveAvailable    Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  publishedAt           DateTime?

  exclusiveSold      Boolean           @default(false)
  width              Int?
  height             Int?
  processingStatus   String            @default("ready")

  contributor      User              @relation("ContributorPhotos", fields: [contributorId], references: [id])
  tags             PhotoTag[]
  rightsRecord     RightsRecord?
  moderationItems  ModerationItem[]
  modelReleases    ModelRelease[]
  licenseGrants    LicenseGrant[]
  licenseQuotes    LicenseQuote[]
  assets           PhotoAsset[]
  payments         Payment[]
  earningsLedgers  EarningsLedger[]
  aiSuggestions    AiSuggestion[]
  favorites        PhotoFavorite[]
  collectionPhotos CollectionPhoto[]

  @@index([status])
  @@index([category])
  @@index([country])
  @@index([contributorId])
}

model AiSuggestion {
  id                      String   @id @default(cuid())
  photoId                 String
  requestedById           String
  provider                String
  status                  String   @default("ready")
  title                   String?
  description             String?
  category                String?
  country                 String?
  tags                    String[]
  hasRecognizablePeople   Boolean?
  notes                   String?
  createdAt               DateTime @default(now())
  appliedAt               DateTime?

  photo       Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("AiSuggestionRequester", fields: [requestedById], references: [id])

  @@index([photoId])
  @@index([requestedById])
}

enum AssetKind {
  original
  preview
  watermarked
  thumb
}

model PhotoAsset {
  id         String    @id @default(cuid())
  photoId    String
  kind       AssetKind
  storageKey String
  bytes      Int       @default(0)
  width      Int?
  height     Int?
  mimeType   String    @default("image/jpeg")
  createdAt  DateTime  @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, kind])
  @@index([storageKey])
}

model PhotoTag {
  id      String @id @default(cuid())
  photoId String
  tag     String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, tag])
  @@index([tag])
}

model PhotoFavorite {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
  @@index([photoId])
  @@index([userId])
}

model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  agencyId    String?
  name        String
  description String?
  visibility  String   @default("private")
  shareToken  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User              @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agency Agency?           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  photos CollectionPhoto[]

  @@index([ownerId])
  @@index([agencyId])
}

model CollectionPhoto {
  id           String   @id @default(cuid())
  collectionId String
  photoId      String
  addedById    String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photo      Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  addedBy    User       @relation("CollectionAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([collectionId, photoId])
  @@index([photoId])
  @@index([addedById])
}

model RightsRecord {
  id                   String             @id @default(cuid())
  photoId              String             @unique
  copyrightVerified    Boolean            @default(false)
  copyrightHolder      String?
  modelReleaseRequired Boolean            @default(false)
  modelReleaseStatus   ModelReleaseStatus @default(not_required)
  modelReleaseFileKey  String?
  platformRightsOk     Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

model ModelRelease {
  id           String             @id @default(cuid())
  photoId      String
  fileName     String
  notes        String?
  status       ModelReleaseStatus @default(pending)
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())

  photo      Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("ModelReleaseReviewer", fields: [verifiedById], references: [id])

  @@index([photoId])
  @@index([status])
}

model LicenseProduct {
  id                   String           @id
  type                 GrantLicenseType @unique
  name                 String
  description          String
  defaultUsd           Float            @default(0)
  points               String[]
  commercialAllowed    Boolean          @default(true)
  requiresModelRelease Boolean          @default(false)
  agencyPreferred      Boolean          @default(false)
  quoteOnly            Boolean          @default(false)
  exclusiveOptIn       Boolean          @default(false)
  sortOrder            Int              @default(0)
  active               Boolean          @default(true)
  grants               LicenseGrant[]
  quotes               LicenseQuote[]
  payments             Payment[]
}

enum QuoteStatus {
  pending
  quoted
  accepted
  declined
}

model LicenseQuote {
  id          String         @id @default(cuid())
  photoId     String
  requesterId String
  agencyId    String?
  productId   String
  territory   String
  duration    String
  channels    String
  notes       String?
  quoteUsd    Float?
  status      QuoteStatus    @default(pending)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  photo     Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  requester User           @relation("QuoteRequester", fields: [requesterId], references: [id])
  agency    Agency?        @relation(fields: [agencyId], references: [id])
  product   LicenseProduct @relation(fields: [productId], references: [id])
  grants    LicenseGrant[]

  @@index([photoId])
  @@index([requesterId])
  @@index([agencyId])
  @@index([status])
}

model LicenseGrant {
  id              String           @id @default(cuid())
  buyerId         String
  photoId         String
  productId       String
  agencyId        String?
  quoteId         String?          @unique
  licenseType     GrantLicenseType
  amountUsd       Float
  currency        String           @default("USD")
  amountLocal     Float
  scopeJson       Json
  certificateCode String           @unique
  createdAt       DateTime         @default(now())

  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  photo   Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  product LicenseProduct @relation(fields: [productId], references: [id])
  agency  Agency?        @relation(fields: [agencyId], references: [id])
  quote   LicenseQuote?  @relation(fields: [quoteId], references: [id])
  payment Payment?

  @@index([buyerId])
  @@index([photoId])
  @@index([agencyId])
}

model Payment {
  id          String   @id @default(cuid())
  buyerId     String
  photoId     String
  productId   String
  quoteId     String?
  grantId     String?  @unique
  provider    String
  status      String   @default("pending")
  amountUsd   Float
  currency    String
  amountLocal Float
  providerRef String?  @unique
  checkoutUrl String?
  metadata    Json?
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  photo   Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)
  product LicenseProduct @relation(fields: [productId], references: [id])
  grant   LicenseGrant?  @relation(fields: [grantId], references: [id])
  earnings EarningsLedger[]

  @@index([buyerId])
  @@index([photoId])
  @@index([status])
}

model PayoutMethod {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  label       String
  accountName String
  accountRef  String
  bankName    String?
  country     String?
  currency    String   @default("USD")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([userId])
}

model Payout {
  id             String    @id @default(cuid())
  contributorId  String
  payoutMethodId String
  amountUsd      Float
  status         String    @default("requested")
  notes          String?
  provider       String    @default("manual")
  providerRef    String?
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?
  processedById  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contributor User         @relation("ContributorPayouts", fields: [contributorId], references: [id], onDelete: Cascade)
  method      PayoutMethod @relation(fields: [payoutMethodId], references: [id])
  processor   User?        @relation("PayoutProcessor", fields: [processedById], references: [id])
  ledger      EarningsLedger[]

  @@index([contributorId])
  @@index([status])
}

model EarningsLedger {
  id            String   @id @default(cuid())
  contributorId String
  photoId       String
  paymentId     String?
  grantId       String?
  payoutId      String?
  source        String
  amountUsd     Float
  status        String   @default("available")
  createdAt     DateTime @default(now())

  contributor User     @relation("ContributorEarnings", fields: [contributorId], references: [id], onDelete: Cascade)
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  payment     Payment? @relation(fields: [paymentId], references: [id])
  payout      Payout?  @relation(fields: [payoutId], references: [id])

  @@index([contributorId])
  @@index([photoId])
  @@index([payoutId])
}

model AgreementVersion {
  version     String   @id
  title       String
  body        String
  current     Boolean  @default(false)
  publishedAt DateTime @default(now())
}

model PlatformAgreement {
  id              String                  @id @default(cuid())
  userId          String
  version         String
  status          PlatformAgreementStatus @default(accepted)
  acceptedAt      DateTime                @default(now())
  ipAddress       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModerationItem {
  id           String    @id @default(cuid())
  photoId      String
  flag         String
  status       String    @default("pending")
  submittedBy  String
  reviewerId   String?
  decidedAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  photo    Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ModerationReviewer", fields: [reviewerId], references: [id])

  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  initiatedBy String    @default("self")
  adminId     String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
}

model PlatformSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(true)
  label     String?
  group     String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Country {
  code                  String   @id
  name                  String
  currency              String
  currencyName          String
  region                String
  contributorEligible   Boolean  @default(false)
  enabled               Boolean  @default(true)
  sortOrder             Int      @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([region])
  @@index([contributorEligible])
}

model ExchangeRate {
  currency     String    @id
  rateToUsd    Float
  source       String    @default("auto")
  overrideRate Float?
  fetchedAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

model PaymentGateway {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  kind        String
  countries   String[]
  currencies  String[]
  configEnc   String?
  publicKey   String?
  notes       String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiProvider {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  purpose    String
  apiBaseUrl String?
  apiKeyEnc  String?
  notes      String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
